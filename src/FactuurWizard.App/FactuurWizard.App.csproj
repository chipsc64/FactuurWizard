<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FactuurWizard.Core\FactuurWizard.Core.csproj" />
    <ProjectReference Include="..\FactuurWizard.Data\FactuurWizard.Data.csproj" />
    <ProjectReference Include="..\FactuurWizard.Pdf\FactuurWizard.Pdf.csproj" />
    <ProjectReference Include="..\FactuurWizard.Export\FactuurWizard.Export.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Eigen Main (Program.cs), zodat Velopack als eerste kan draaien bij installeren en bijwerken. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\FactuurWizard.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>FactuurWizard.App.Program</StartupObject>

    <AssemblyName>FactuurWizard</AssemblyName>
    <RootNamespace>FactuurWizard.App</RootNamespace>
    <Product>FactuurWizard</Product>
    <Description>Facturen maken voor kleine zelfstandigen</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\FactuurWizard.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
