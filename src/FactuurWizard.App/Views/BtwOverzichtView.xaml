<UserControl x:Class="FactuurWizard.App.Views.BtwOverzichtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FactuurWizard.App.ViewModels"
             xmlns:c="clr-namespace:FactuurWizard.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BtwOverzichtViewModel}">
    <UserControl.Resources>
        <c:NullNaarZichtbaarheidConverter x:Key="NietNull" />
        <Style x:Key="Rechts" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Exporteren naar Excel" Style="{StaticResource PrimaireKnop}" Command="{Binding ExporteerCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Melding}" Style="{StaticResource Melding}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="110" Margin="0,0,12,0">
                    <TextBlock Text="Jaar" Style="{StaticResource Veldlabel}" />
                    <ComboBox ItemsSource="{Binding Jaren}" SelectedItem="{Binding GekozenJaar}" />
                </StackPanel>
                <StackPanel Width="220">
                    <TextBlock Text="Periode" Style="{StaticResource Veldlabel}" />
                    <ComboBox ItemsSource="{Binding Kwartalen}" DisplayMemberPath="Omschrijving"
                              SelectedValuePath="Waarde" SelectedValue="{Binding GekozenKwartaal}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Paneel}" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Rubrieken btw-aangifte" Style="{StaticResource Sectiekop}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="Omzet excl. btw" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Btw" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Overzicht.Rubrieken}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Omschrijving}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Omzet, StringFormat=C}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding Btw, StringFormat=C}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{StaticResource RandBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="5a" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Verschuldigde omzetbelasting" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="{Binding Overzicht.VerschuldigdeBtw, StringFormat=C}"
                                       FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding KorTekst}" Style="{StaticResource Hulptekst}" Margin="0,8,0,0"
                               Visibility="{Binding KorTekst, Converter={StaticResource NietNull}}" />
                    <TextBlock Style="{StaticResource Hulptekst}" Margin="0,8,0,0"
                               Text="Volgens het factuurstelsel, op factuurdatum. Voorbelasting (5b) komt uit uw inkoopfacturen en staat hier niet in. In de aangifte vult u hele euro's in." />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding AantalTekst}" Margin="0,0,0,6" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Overzicht.Facturen}" IsReadOnly="True" Margin="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nummer" Binding="{Binding Factuur.Factuurnummer}" Width="90" />
                <DataGridTextColumn Header="Datum" Binding="{Binding Factuur.Factuurdatum, StringFormat={}{0:dd-MM-yyyy}}" Width="90" />
                <DataGridTextColumn Header="Klant" Binding="{Binding Factuur.KlantGegevens.Naam}" Width="*" />
                <DataGridTextColumn Header="1a omzet" Binding="{Binding Omzet1a, StringFormat=C}" Width="95" ElementStyle="{StaticResource Rechts}" />
                <DataGridTextColumn Header="1a btw" Binding="{Binding Btw1a, StringFormat=C}" Width="85" ElementStyle="{StaticResource Rechts}" />
                <DataGridTextColumn Header="1b omzet" Binding="{Binding Omzet1b, StringFormat=C}" Width="95" ElementStyle="{StaticResource Rechts}" />
                <DataGridTextColumn Header="1b btw" Binding="{Binding Btw1b, StringFormat=C}" Width="85" ElementStyle="{StaticResource Rechts}" />
                <DataGridTextColumn Header="1e omzet" Binding="{Binding Omzet1e, StringFormat=C}" Width="95" ElementStyle="{StaticResource Rechts}" />
                <DataGridTextColumn Header="Totaal incl." Binding="{Binding TotaalInclBtw, StringFormat=C, Mode=OneWay}" Width="105" ElementStyle="{StaticResource Rechts}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
