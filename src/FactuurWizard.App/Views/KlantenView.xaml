<UserControl x:Class="FactuurWizard.App.Views.KlantenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FactuurWizard.App.ViewModels"
             xmlns:c="clr-namespace:FactuurWizard.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:KlantenViewModel}">
    <UserControl.Resources>
        <c:NullNaarZichtbaarheidConverter x:Key="NietNull" />
        <c:NietConverter x:Key="Niet" />
        <BooleanToVisibilityConverter x:Key="Zichtbaar" />

        <!-- Adresvelden; DataContext is een Adres. -->
        <DataTemplate x:Key="AdresVelden">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Straat" Style="{StaticResource Veldlabel}" />
                        <TextBox Text="{Binding Straat}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Huisnummer" Style="{StaticResource Veldlabel}" />
                        <TextBox Text="{Binding Huisnummer}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Postcode" Style="{StaticResource Veldlabel}" />
                        <TextBox Text="{Binding Postcode}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Plaats" Style="{StaticResource Veldlabel}" />
                        <TextBox Text="{Binding Plaats}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Land" Style="{StaticResource Veldlabel}" />
                        <TextBox Text="{Binding Land}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Opslaan" Style="{StaticResource PrimaireKnop}" Command="{Binding OpslaanCommand}" />
                <Button Content="Nieuwe klant" Command="{Binding NieuwCommand}" />
                <Button Content="Verwijderen" Command="{Binding VerwijderCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Melding}" Style="{StaticResource Melding}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- Lijst -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Zoeken op naam, nummer, plaats of e-mail" Style="{StaticResource Veldlabel}" />
                    <TextBox Text="{Binding Zoekterm, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Gearchiveerde klanten tonen" IsChecked="{Binding ToonGearchiveerd}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding KlantenView}" SelectedItem="{Binding Geselecteerd}"
                          IsReadOnly="True" SelectionMode="Single" Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nr." Binding="{Binding Klantnummer}" Width="60" />
                        <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="2*" />
                        <DataGridTextColumn Header="Plaats" Binding="{Binding Adres.Plaats}" Width="*" />
                        <DataGridTextColumn Header="Soort" Binding="{Binding Soort}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Detail -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Geselecteerd, Converter={StaticResource NietNull}}">
                <Border Style="{StaticResource Paneel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="Particulier" Margin="0,0,20,0"
                                         IsChecked="{Binding IsBedrijf, Converter={StaticResource Niet}}" />
                            <RadioButton Content="Bedrijf" IsChecked="{Binding IsBedrijf}" />
                            <TextBlock Margin="24,0,0,0" Foreground="{StaticResource TekstGedemptBrush}"
                                       Text="{Binding Geselecteerd.Klantnummer, StringFormat=Klantnummer {0}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding NaamLabel}" Style="{StaticResource Veldlabel}" />
                        <TextBox Text="{Binding Geselecteerd.Naam}" />

                        <StackPanel Visibility="{Binding IsBedrijf, Converter={StaticResource Zichtbaar}}">
                            <TextBlock Text="Contactpersoon" Style="{StaticResource Veldlabel}" />
                            <TextBox Text="{Binding Geselecteerd.Contactpersoon}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="KvK-nummer" Style="{StaticResource Veldlabel}" />
                                    <TextBox Text="{Binding Geselecteerd.KvkNummer}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Btw-nummer" Style="{StaticResource Veldlabel}" />
                                    <TextBox Text="{Binding Geselecteerd.BtwNummer}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Adres" Style="{StaticResource Sectiekop}" Margin="0,8,0,8" />
                        <ContentPresenter Content="{Binding Geselecteerd.Adres}" ContentTemplate="{StaticResource AdresVelden}" />
                        <CheckBox Content="Afwijkend factuuradres" IsChecked="{Binding HeeftFactuuradres}" />
                        <!-- Zichtbaarheid op de Border: een ContentPresenter gebruikt zijn Content als DataContext. -->
                        <Border Visibility="{Binding HeeftFactuuradres, Converter={StaticResource Zichtbaar}}">
                            <ContentPresenter Content="{Binding Geselecteerd.Factuuradres}" ContentTemplate="{StaticResource AdresVelden}" />
                        </Border>

                        <TextBlock Text="Contact" Style="{StaticResource Sectiekop}" Margin="0,8,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="E-mailadres (voor facturen)" Style="{StaticResource Veldlabel}" />
                                <TextBox Text="{Binding Geselecteerd.Email}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Telefoon" Style="{StaticResource Veldlabel}" />
                                <TextBox Text="{Binding Geselecteerd.Telefoon}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Overig" Style="{StaticResource Sectiekop}" Margin="0,8,0,8" />
                        <TextBlock Text="Afwijkende betalingstermijn in dagen (leeg = standaard)" Style="{StaticResource Veldlabel}" />
                        <TextBox Text="{Binding Geselecteerd.BetalingstermijnDagen, TargetNullValue=''}" Width="90" HorizontalAlignment="Left" />
                        <TextBlock Text="Notities" Style="{StaticResource Veldlabel}" />
                        <TextBox Text="{Binding Geselecteerd.Notities}" Style="{StaticResource MeerregeligeTekst}" />
                        <CheckBox Content="Gearchiveerd (niet meer te kiezen op nieuwe facturen)" IsChecked="{Binding Geselecteerd.Gearchiveerd}" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
