<UserControl x:Class="FactuurWizard.App.Views.BtwTarievenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FactuurWizard.App.ViewModels"
             xmlns:c="clr-namespace:FactuurWizard.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BtwTarievenViewModel}">
    <UserControl.Resources>
        <c:DateOnlyConverter x:Key="DateOnly" />
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Opslaan" Style="{StaticResource PrimaireKnop}" Command="{Binding OpslaanCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Melding}" Style="{StaticResource Melding}" />
        </StackPanel>

        <Border Style="{StaticResource Paneel}" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Btw-groep" Style="{StaticResource Sectiekop}" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Groepen}" SelectedItem="{Binding GeselecteerdeGroep}"
                             DisplayMemberPath="Omschrijving" BorderBrush="{StaticResource RandBrush}" Padding="2" />
                    <TextBlock Style="{StaticResource Hulptekst}" Margin="0,12,0,0"
                               Text="Op een factuur wordt het tarief gebruikt dat geldt op de factuurdatum. Definitieve facturen behouden hun tarief." />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tarieven" Style="{StaticResource Sectiekop}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding GeselecteerdeGroep.Tarieven}" SelectedItem="{Binding GeselecteerdTarief}"
                              MinHeight="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Percentage" Width="100"
                                                Binding="{Binding Percentage, StringFormat={}{0:0.##}}" />
                            <DataGridTemplateColumn Header="Ingangsdatum" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker Margin="0" BorderThickness="0"
                                                    SelectedDate="{Binding Ingangsdatum, Converter={StaticResource DateOnly}, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Einddatum" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker Margin="0" BorderThickness="0"
                                                    SelectedDate="{Binding Einddatum, Converter={StaticResource DateOnly}, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Geselecteerd tarief verwijderen" HorizontalAlignment="Left"
                            Command="{Binding VerwijderTariefCommand}" />

                    <TextBlock Text="Nieuw tarief" Style="{StaticResource Sectiekop}" />
                    <TextBlock Style="{StaticResource Hulptekst}"
                               Text="Bij een tariefwijziging door de overheid voegt u het nieuwe tarief toe met de ingangsdatum. Het huidige tarief eindigt dan automatisch op de dag ervoor." />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="100" Margin="0,0,8,0">
                            <TextBlock Text="Percentage" Style="{StaticResource Veldlabel}" />
                            <TextBox Text="{Binding NieuwPercentage, TargetNullValue=''}" />
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,8,0">
                            <TextBlock Text="Ingangsdatum" Style="{StaticResource Veldlabel}" />
                            <DatePicker SelectedDate="{Binding NieuweIngangsdatum}" />
                        </StackPanel>
                        <Button Content="Toevoegen" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Command="{Binding VoegTariefToeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
