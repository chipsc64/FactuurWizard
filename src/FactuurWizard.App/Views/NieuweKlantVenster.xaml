<Window x:Class="FactuurWizard.App.Views.NieuweKlantVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nieuwe klant" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource PaneelBrush}">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="Particulier" Content="Particulier" IsChecked="True" Margin="0,0,20,0" Checked="Soort_Gewijzigd" />
            <RadioButton x:Name="Bedrijf" Content="Bedrijf" Checked="Soort_Gewijzigd" />
        </StackPanel>

        <TextBlock x:Name="NaamLabel" Text="Naam *" Style="{StaticResource Veldlabel}" />
        <TextBox x:Name="NaamVeld" Text="{Binding Naam}" />

        <StackPanel x:Name="BedrijfVelden" Visibility="Collapsed">
            <TextBlock Text="Contactpersoon" Style="{StaticResource Veldlabel}" />
            <TextBox Text="{Binding Contactpersoon}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Straat" Style="{StaticResource Veldlabel}" />
                <TextBox Text="{Binding Adres.Straat}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Huisnummer" Style="{StaticResource Veldlabel}" />
                <TextBox Text="{Binding Adres.Huisnummer}" />
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Postcode" Style="{StaticResource Veldlabel}" />
                <TextBox Text="{Binding Adres.Postcode}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Plaats" Style="{StaticResource Veldlabel}" />
                <TextBox Text="{Binding Adres.Plaats}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="E-mailadres" Style="{StaticResource Veldlabel}" />
        <TextBox Text="{Binding Email}" />

        <TextBlock Style="{StaticResource Hulptekst}"
                   Text="Overige gegevens, zoals KvK- en btw-nummer, vult u later aan bij Klanten." />
        <TextBlock x:Name="Fouttekst" Foreground="{StaticResource FoutBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Toevoegen" Style="{StaticResource PrimaireKnop}" IsDefault="True" Click="Toevoegen_Click" />
            <Button Content="Annuleren" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
