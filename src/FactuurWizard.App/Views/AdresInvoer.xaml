<UserControl x:Class="FactuurWizard.App.Views.AdresInvoer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext is een Adres. Postcode, huisnummer en toevoeging werken direct bij, zodat het opzoeken meteen kan. -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="85" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Postcode" Style="{StaticResource Veldlabel}" />
                <TextBox x:Name="PostcodeVeld" Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Zoekveld_TextChanged" AutomationProperties.Name="Postcode" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Huisnummer" Style="{StaticResource Veldlabel}" />
                <TextBox x:Name="HuisnummerVeld" Text="{Binding Huisnummer, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Zoekveld_TextChanged" AutomationProperties.Name="Huisnummer" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Toevoeging" Style="{StaticResource Veldlabel}" />
                <ComboBox x:Name="ToevoegingVeld" IsEditable="True" IsTextSearchEnabled="False"
                          Text="{Binding Toevoeging, UpdateSourceTrigger=PropertyChanged}"
                          TextBoxBase.TextChanged="Toevoeging_TextChanged" AutomationProperties.Name="Toevoeging" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusTekst" Style="{StaticResource Hulptekst}" Margin="0,-4,0,8" Visibility="Collapsed" />

        <TextBlock Text="Straat" Style="{StaticResource Veldlabel}" />
        <TextBox x:Name="StraatVeld" Text="{Binding Straat}" AutomationProperties.Name="Straat" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Plaats" Style="{StaticResource Veldlabel}" />
                <TextBox x:Name="PlaatsVeld" Text="{Binding Plaats}" AutomationProperties.Name="Plaats" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Land" Style="{StaticResource Veldlabel}" />
                <TextBox x:Name="LandVeld" Text="{Binding Land, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Zoekveld_TextChanged" AutomationProperties.Name="Land" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
