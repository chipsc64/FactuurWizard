<UserControl x:Class="FactuurWizard.App.Views.FactuurBewerkenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FactuurWizard.App.ViewModels"
             xmlns:c="clr-namespace:FactuurWizard.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FactuurBewerkenViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Zichtbaar" />
        <c:NullNaarZichtbaarheidConverter x:Key="NietNull" />
        <c:NietConverter x:Key="Niet" />
        <Style x:Key="Rechts" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="RechtsBewerken" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Knoppen onderaan -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Terug naar overzicht" Command="{Binding TerugCommand}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsConcept, Converter={StaticResource Zichtbaar}}">
                    <Button Content="Opslaan" Command="{Binding OpslaanCommand}" />
                    <Button Content="Voorbeeld (PDF)" Command="{Binding VoorbeeldCommand}" />
                    <Button Content="Definitief maken" Style="{StaticResource PrimaireKnop}" Command="{Binding MaakDefinitiefCommand}" />
                    <Button Content="Concept verwijderen" Command="{Binding VerwijderConceptCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDefinitief, Converter={StaticResource Zichtbaar}}">
                    <Button Content="PDF openen" Style="{StaticResource PrimaireKnop}" Command="{Binding PdfOpenenCommand}" />
                    <Button Content="E-mailen" Command="{Binding EmailenCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding KanCrediteren, Converter={StaticResource Zichtbaar}}">
                    <Button Content="Creditfactuur maken" Command="{Binding MaakCreditfactuurCommand}" />
                    <Button Content="Kopiëren als nieuwe factuur" Command="{Binding KopieCommand}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding Melding}" Style="{StaticResource Melding}" />
        </StackPanel>

        <!-- Kop: klant en factuurgegevens -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding CreditInfo}" Style="{StaticResource Hulptekst}"
                       Visibility="{Binding CreditInfo, Converter={StaticResource NietNull}}" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Paneel}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Klant" Style="{StaticResource Sectiekop}" Margin="0,0,0,8" />
                        <DockPanel Visibility="{Binding IsConcept, Converter={StaticResource Zichtbaar}}"
                                   IsEnabled="{Binding IsCredit, Converter={StaticResource Niet}}">
                            <Button DockPanel.Dock="Right" Content="Nieuwe klant…" Margin="8,0,0,10" Command="{Binding NieuweKlantCommand}" />
                            <ComboBox ItemsSource="{Binding Klanten}" SelectedItem="{Binding GekozenKlant}"
                                      DisplayMemberPath="Naam" IsTextSearchEnabled="True" />
                        </DockPanel>
                        <TextBlock Text="{Binding KlantNaam}" FontWeight="SemiBold"
                                   Visibility="{Binding IsDefinitief, Converter={StaticResource Zichtbaar}}" />
                        <TextBlock Text="{Binding KlantAdres}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Paneel}" Padding="16">
                    <Grid IsEnabled="{Binding IsConcept}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="5" Text="Gegevens" Style="{StaticResource Sectiekop}" Margin="0,0,0,8" />

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Factuurdatum" Style="{StaticResource Veldlabel}" />
                            <DatePicker SelectedDate="{Binding Factuurdatum}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Leverdatum (optioneel)" Style="{StaticResource Veldlabel}" />
                            <DatePicker SelectedDate="{Binding Leverdatum}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4">
                            <TextBlock Text="Tot en met (optioneel)" Style="{StaticResource Veldlabel}" />
                            <DatePicker SelectedDate="{Binding LeverperiodeEind}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Betalingstermijn (dagen)" Style="{StaticResource Veldlabel}" />
                            <TextBox Text="{Binding Betalingstermijn}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Vervaldatum" Style="{StaticResource Veldlabel}" />
                            <TextBlock Text="{Binding Vervaldatum, StringFormat={}{0:dd-MM-yyyy}}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Opmerking en totalen -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Visibility="{Binding ToonOpmerking, Converter={StaticResource Zichtbaar}}">
                    <TextBlock Text="Opmerking op de factuur (optioneel)" Style="{StaticResource Veldlabel}" />
                    <TextBox Text="{Binding Opmerking}" Style="{StaticResource MeerregeligeTekst}" MinHeight="60"
                             IsReadOnly="{Binding IsDefinitief}" />
                </StackPanel>
            <!-- Betaling en herinneringen (alleen bij een definitieve factuur) -->
            <Border Style="{StaticResource Paneel}" Padding="16,12"
                    Visibility="{Binding ToonBetaling, Converter={StaticResource Zichtbaar}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Betaling" Style="{StaticResource Sectiekop}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding BetaalstatusTekst}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding KanBetaaldMarkeren, Converter={StaticResource Zichtbaar}}">
                            <DatePicker SelectedDate="{Binding BetaaldOpInvoer}" Width="140" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button Content="Markeer als betaald" Command="{Binding MarkeerBetaaldCommand}" />
                        </StackPanel>
                        <Button Content="Betaling ongedaan maken" HorizontalAlignment="Left" Command="{Binding BetalingOngedaanCommand}"
                                Visibility="{Binding IsBetaald, Converter={StaticResource Zichtbaar}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Herinneringen" Style="{StaticResource Sectiekop}" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding Herinneringen}" SelectedItem="{Binding GeselecteerdeHerinnering}"
                                 DisplayMemberPath="Omschrijving" MaxHeight="72" Margin="0,0,0,8" BorderBrush="{StaticResource RandBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Herinneringen.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding KanHerinneren, Converter={StaticResource Zichtbaar}}">
                                <TextBlock Text="Termijn" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding HerinneringTermijn}" Width="40" Margin="0,0,4,0" />
                                <TextBlock Text="dagen" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Content="Herinnering maken" Command="{Binding MaakHerinneringCommand}" />
                            </StackPanel>
                            <Button Content="Openen" Command="{Binding HerinneringOpenenCommand}" />
                            <Button Content="E-mailen" Command="{Binding HerinneringEmailenCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Paneel}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Subtotaal excl. btw" />
                    <TextBlock Grid.Column="1" Text="{Binding Totalen.TotaalExclBtw, StringFormat=C}" HorizontalAlignment="Right" />

                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding BtwRegels}" Margin="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BtwRegelWeergave}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource TekstGedemptBrush}">
                                        <Run Text="{Binding Omschrijving, Mode=OneWay}" />
                                        <Run Text="{Binding Grondslag, StringFormat=over {0:C}, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Btw, StringFormat=C}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource RandBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Totaal" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Grid.Column="1" Text="{Binding Totalen.TotaalInclBtw, StringFormat=C}" FontWeight="SemiBold" FontSize="15" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Regels -->
        <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding IsConcept, Converter={StaticResource Zichtbaar}}">
                <Button Content="+ Vrije regel" Command="{Binding VoegVrijeRegelToeCommand}" />
                <ComboBox ItemsSource="{Binding Artikelen}" SelectedItem="{Binding GekozenArtikel}" Width="280" Margin="8,0,4,0"
                          IsTextSearchEnabled="True" TextSearch.TextPath="Omschrijving" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Omschrijving, Mode=OneWay}" />
                                <Run Text="{Binding PrijsExclBtw, StringFormat=({0:C}), Mode=OneWay}" Foreground="{StaticResource TekstGedemptBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="+ Product/dienst" Command="{Binding VoegArtikelToeCommand}" />
                <Button Content="▲" MinWidth="36" Margin="24,0,4,0" ToolTip="Regel omhoog" Command="{Binding RegelOmhoogCommand}" />
                <Button Content="▼" MinWidth="36" ToolTip="Regel omlaag" Command="{Binding RegelOmlaagCommand}" />
                <Button Content="Regel verwijderen" Command="{Binding VerwijderRegelCommand}" />
            </WrapPanel>

            <DataGrid ItemsSource="{Binding Regels}" SelectedItem="{Binding GeselecteerdeRegel}" SelectionMode="Single"
                      IsReadOnly="{Binding IsDefinitief}" Margin="0" RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Soort" Binding="{Binding SoortOmschrijving, Mode=OneWay}" IsReadOnly="True" Width="65" />
                    <DataGridTextColumn Header="Art.nr." Binding="{Binding Artikelnummer}" Width="70" />
                    <DataGridTextColumn Header="Omschrijving" Binding="{Binding Omschrijving}" Width="*" />
                    <DataGridTextColumn Header="Aantal" Binding="{Binding Aantal, StringFormat={}{0:0.##}}" Width="65"
                                        ElementStyle="{StaticResource Rechts}" EditingElementStyle="{StaticResource RechtsBewerken}" />
                    <DataGridTextColumn Header="Eenheid" Binding="{Binding Eenheid}" Width="70" />
                    <DataGridTextColumn Header="Prijs excl." Binding="{Binding PrijsExclBtw, StringFormat={}{0:0.00##}}" Width="90"
                                        ElementStyle="{StaticResource Rechts}" EditingElementStyle="{StaticResource RechtsBewerken}" />
                    <DataGridTemplateColumn Header="Btw" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Margin="0" Padding="4,2" BorderThickness="0"
                                          ItemsSource="{Binding DataContext.BtwGroepen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          IsEnabled="{Binding DataContext.IsConcept, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="Omschrijving" SelectedValuePath="Waarde"
                                          SelectedValue="{Binding BtwGroepId, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="%" Binding="{Binding BtwPercentage, StringFormat={}{0:0.##}, Mode=OneWay}" IsReadOnly="True" Width="45"
                                        ElementStyle="{StaticResource Rechts}" />
                    <DataGridTextColumn Header="Bedrag" Binding="{Binding Bedrag, StringFormat=C, Mode=OneWay}" IsReadOnly="True" Width="100"
                                        ElementStyle="{StaticResource Rechts}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</UserControl>
