<Window x:Class="FactuurWizard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FactuurWizard.App.ViewModels"
        xmlns:c="clr-namespace:FactuurWizard.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        Title="FactuurWizard" Height="760" Width="1200" MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/FactuurWizard.ico"
        Background="{StaticResource AchtergrondBrush}"
        Closing="Window_Closing">
    <Window.Resources>
        <c:NullNaarZichtbaarheidConverter x:Key="NietNullZichtbaar" />
        <CollectionViewSource x:Key="Navigatie" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Groep" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <DockPanel>
        <!-- Navigatie -->
        <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource AccentBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="FactuurWizard" Foreground="White" FontSize="20"
                           FontWeight="SemiBold" Margin="18,20,18,16" />
                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,12">
                    <TextBlock Margin="0,0,0,4">
                        <Hyperlink NavigateUri="https://github.com/chipsc64/FactuurWizard/blob/main/Docs/Handleiding.md"
                                   RequestNavigate="Link_RequestNavigate" Foreground="White">Handleiding</Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding VersieTekst, Mode=OneTime}" Foreground="#B9CCE0" FontSize="11" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Source={StaticResource Navigatie}}"
                         SelectedItem="{Binding GeselecteerdItem}"
                         Background="Transparent" BorderThickness="0" Foreground="White"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="#B9CCE0" FontSize="11"
                                               FontWeight="SemiBold" Margin="14,12,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Rand" Background="Transparent" Padding="18,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Rand" Property="Background" Value="#2A5F90" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Rand" Property="Background" Value="#3D76AB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigatieItem}">
                            <TextBlock Text="{Binding Titel}" Foreground="White" FontSize="14" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Inhoud -->
        <Grid Margin="28,20,28,20">
            <!-- Pagina's vullen de breedte tot maximaal 1100 px, links uitgelijnd. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1100" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <!-- Melding als er een nieuwe versie is -->
                <Border DockPanel.Dock="Top" Background="{StaticResource AccentLichtBrush}" BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,8" Margin="0,0,0,14"
                        Visibility="{Binding Updater.NieuweVersie, Converter={StaticResource NietNullZichtbaar}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Nu bijwerken" Style="{StaticResource PrimaireKnop}" Margin="12,0,0,0"
                                Command="{Binding BijwerkenCommand}" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run Text="Er is een nieuwe versie van FactuurWizard beschikbaar:" />
                            <Run Text="{Binding Updater.NieuweVersie, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding Updater.Voortgang, Mode=OneWay, StringFormat=(downloaden {0}%), TargetNullValue=''}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="{Binding HuidigePagina.Titel}" Style="{StaticResource Paginakop}" />
                <ContentControl Content="{Binding HuidigePagina}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
